#!/usr/bin/env bash
#
# qed: the Qed toolchain entry point.
#
# Sets up the environment (Lean via elan), builds the CLI if needed,
# then runs it. Usage: `./scripts/qed <command>`.
set -euo pipefail

# Run from the project root regardless of where we're invoked.
cd "$(cd "$(dirname "$0")/.." && pwd)"

export PATH="${HOME}/.elan/bin:${PATH}"
# In-repo development: the framework is the current directory, and the demo's
# web entry is Examples.Counter (installed apps default to `Web`). Both are
# overridable, e.g. `QED_WEB_ROOT=Examples.Chat ./scripts/qed build --dev`.
export QED_HOME="${QED_HOME:-${PWD}}"
export QED_WEB_ROOT="${QED_WEB_ROOT:-Examples.Counter}"

# Build the CLI (skip `lake` altogether when `.lake/build/bin/qed` is newer than CLI sources).
if [ ! -x .lake/build/bin/qed ] || \
   [ -n "$(find Cli.lean Cli Qed/Cloud rust/qed_server/src/watch.rs lakefile.lean lean-toolchain -newer .lake/build/bin/qed 2>/dev/null | head -1)" ]; then
  if ! lake build qed >/dev/null 2>&1; then
    echo "qed: failed to build the CLI" >&2
    lake build qed   # re-run to show the error
    exit 1
  fi
fi

exec .lake/build/bin/qed "$@"
